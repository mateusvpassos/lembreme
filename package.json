{
  "name": "lembreme",
  "version": "0.3.3",
  "description": "Lembreme — lembretes no desktop com aviso no canto da tela",
  "main": "main.js",
  "private": true,
  "author": "Mateus Vinícius dos Passos",
  "license": "MIT",
  "homepage": "https://github.com/mateusvpassos/lembreme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mateusvpassos/lembreme.git"
  },
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "test": "node --test shared/recur.test.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.mateusvpassos.lembreme",
    "productName": "Lembreme",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "shared/recur.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lembreme",
      "artifactName": "Lembreme-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
