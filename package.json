{
  "name": "lembreme",
  "version": "0.2.0",
  "description": "Lembreme — lembretes no desktop com aviso no canto da tela (Electron)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "test": "node --test shared/recur.test.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.mateusvpassos.lembreme",
    "productName": "Lembreme",
    "files": [
      "main.js",
      "preload.js",
      "shared/recur.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lembreme",
      "artifactName": "Lembreme-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
